{
  "name": "@papit/game-shape",
  "description": "Drawable 2D shapes for canvas games: circle, rectangle, line and polygon outlines, with support functions for GJK.",
  "keywords": [
    "papit",
    "game",
    "typescript",
    "shape"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "test": "npx playwright test -c tests/playwright.config.ts $@",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component",
    "test:update-snapshots": "npx playwright test --update-snapshots -c tests/playwright.config.ts",
    "test:chrome": "npm test -- --project=chromium"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LicenseRef-Papit-1.0",
  "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/game/shape",
  "bugs": {
    "url": "https://github.com/onkelhoy/papit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papit.git",
    "directory": "packages/game/shape"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/polygon": "0.0.1",
    "@papit/vector": "0.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "game",
    "main": "shape",
    "components": {
      "shape": {
        "className": "Shape",
        "htmlprefix": "pap"
      }
    }
  }
}