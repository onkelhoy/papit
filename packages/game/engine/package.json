{
  "name": "@papit/game-engine",
  "description": "A canvas game engine for 2D and 3D, with stacked layers, one game loop, game objects and cameras. Reach for it when you build a game or simulation on canvas or WebGL without a framework.",
  "keywords": [
    "papit",
    "game",
    "engine",
    "canvas",
    "webgl",
    "camera"
  ],
  "version": "0.2.0",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "test": "npx playwright test -c tests/playwright.config.ts",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component",
    "test:update-snapshots": "npx playwright test --update-snapshots -c tests/playwright.config.ts",
    "test:chrome": "npm test -- --project=chromium"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LicenseRef-Papit-1.0",
  "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/game/engine",
  "bugs": {
    "url": "https://github.com/onkelhoy/papit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papit.git",
    "directory": "packages/game/engine"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/matrix": "0.0.2",
    "@papit/vector": "0.0.2"
  },
  "devDependencies": {
    "@papit/codeblock": "0.1.18",
    "@papit/theme": "0.0.3",
    "@papit/translator": "0.1.1",
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "skip": false,
    "type": "game",
    "main": "game",
    "components": {
      "game": {
        "className": "Game",
        "htmlprefix": "pap"
      }
    }
  },
  "remoteVersion": "0.1.0"
}