{
    "name": "@papit/game-engine",
    "description": "a game engine dealing with both 2d and 3d ",
    "keywords": [
        "papit",
        "game",
        "typescript",
        "game"
    ],
    "version": "0.0.1",
    "scripts": {
        "build": "npx @papit/build -- --error --ancestors",
        "watch": "tsc -w",
        "start": "npx @papit/server --info --live",
        "test": "npx playwright test -c tests/playwright.config.ts $@",
        "preversion": "papit-version",
        "postversion": "papit-version",
        "component": "npm create @papit -- --component",
        "test:update-snapshots": "npx playwright test --update-snapshots -c tests/playwright.config.ts",
        "test:chrome": "npm test -- --project=chromium"
    },
    "main": "./lib/bundle.js",
    "types": "./lib/bundle.d.ts",
    "type": "module",
    "files": [
        "asset/",
        "lib/"
    ],
    "exports": {
        ".": {
            "import": "./lib/bundle.js",
            "types": "./lib/bundle.d.ts"
        }
    },
    "author": "henry",
    "private": false,
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "license": "LicenseRef-Papit-1.0",
    "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/game/game",
    "bugs": {
        "url": "https://github.com/onkelhoy/papit/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/onkelhoy/papit.git",
        "directory": "packages/game/game"
    },
    "sideEffects": true,
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@papit/vector": "^0.0.1"
    },
    "devDependencies": {
        "@papit/codeblock": "*",
        "@papit/theme": "*",
        "@papit/translator": "*",
        "@playwright/test": "1.58.0",
        "playwright": "1.58.0",
        "typescript": "5.9.3"
    },
    "browserslist": [
        "defaults",
        "not IE 11",
        "not dead"
    ],
    "papit": {
        "publish": true,
        "skip": false,
        "type": "game",
        "main": "game",
        "components": {
            "game": {
                "className": "Game",
                "htmlprefix": "pap"
            }
        }
    },
    "remoteVersion": ""
}