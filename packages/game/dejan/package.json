{
  "name": "@papit/dejan",
  "description": "A small browser platformer as a web component, built on @papit/game-engine.",
  "keywords": [
    "papit",
    "web-component",
    "typescript",
    "dejan"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build --error",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "test": "npx playwright test -c tests/playwright.config.ts $@",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit --component",
    "test:update-snapshots": "npx playwright test --update-snapshots -c tests/playwright.config.ts",
    "test:chrome": "npm test -- --project=chromium",
    "build:react": "bash ./bin/_utils/react.sh"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": true,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LicenseRef-Papit-1.0",
  "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/game/dejan",
  "bugs": {
    "url": "https://github.com/onkelhoy/papit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papit.git",
    "directory": "packages/game/dejan"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/2d-spritesheet": "0.0.1",
    "@papit/button": "0.1.10",
    "@papit/confetti": "0.0.2",
    "@papit/game-engine": "0.2.0",
    "@papit/game-shape": "0.0.1",
    "@papit/icon": "0.1.13",
    "@papit/input": "0.0.10",
    "@papit/moore-neighborhood": "0.0.1",
    "@papit/pixels": "0.0.1",
    "@papit/polygon": "0.0.1",
    "@papit/sat": "0.0.1",
    "@papit/vector": "0.0.2",
    "@papit/web-component": "*"
  },
  "devDependencies": {
    "@papit/codeblock": "*",
    "@papit/theme": "*",
    "@papit/translator": "*",
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": false,
    "skip": true,
    "type": "web-component",
    "main": "dejan",
    "htmlprefix": "pap",
    "components": {
      "dejan": {
        "className": "Dejan",
        "htmlprefix": "pap"
      }
    }
  }
}