{
  "name": "@papit/rigidbody",
  "description": "Deterministic rigid body physics for 2D and 3D games: bodies, contacts and an impulse solver over @papit/gjk.",
  "keywords": [
    "papit",
    "node",
    "typescript",
    "rigidbody",
    "physics",
    "3d",
    "2d",
    "collision"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build --error",
    "watch": "tsc -w",
    "start": "npm run build -- --dev && node ./lib/bundle.js",
    "view": "npx @papit/server --info --live",
    "test": "node --test tests/**/*.test.js",
    "test:only": "node --test --test-only tests/**/*.test.js",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LicenseRef-Papit-1.0",
  "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/game/rigidbody",
  "bugs": {
    "url": "https://github.com/onkelhoy/papit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papit.git",
    "directory": "packages/game/rigidbody"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/box-intersection": "0.0.2",
    "@papit/gjk": "0.0.1",
    "@papit/matrix": "0.0.3",
    "@papit/quaternion": "0.0.2",
    "@papit/vector": "0.1.0"
  },
  "devDependencies": {
    "@papit/game-engine": "0.2.1",
    "@papit/theme": "*",
    "@types/node": "22.10.2",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "node",
    "main": "rigidbody",
    "components": {
      "rigidbody": {
        "className": "Rigidbody",
        "htmlprefix": "pap"
      }
    }
  }
}
