{
  "name": "@papit/audio",
  "description": "Web Audio mixer for games: buses, layered music, crossfades and 3D sound, working on iOS.",
  "keywords": [
    "papit",
    "game",
    "audio",
    "web-audio",
    "mixer",
    "music",
    "crossfade",
    "spatial-audio"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "test": "npx playwright test -c tests/playwright.config.ts",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component",
    "test:update-snapshots": "npx playwright test --update-snapshots -c tests/playwright.config.ts",
    "test:chrome": "npm test -- --project=chromium"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LicenseRef-Papit-1.0",
  "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/game/audio",
  "bugs": {
    "url": "https://github.com/onkelhoy/papit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papit.git",
    "directory": "packages/game/audio"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@papit/button": "*",
    "@papit/game-engine": "*",
    "@papit/joystick": "*",
    "@papit/switch": "*",
    "@papit/theme": "*",
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "browser",
    "main": "audio",
    "htmlprefix": "pap",
    "components": {
      "audio": {
        "className": "Audio",
        "htmlprefix": "pap"
      }
    }
  }
}
