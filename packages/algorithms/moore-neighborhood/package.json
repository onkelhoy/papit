{
  "name": "@papit/moore-neighborhood",
  "description": "simplistic yet powerful algorithm to turn a image into polygon shapes ",
  "keywords": [
    "papit",
    "web-component",
    "typescript",
    "moore-neighborhood"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "test": "npx playwright test -c tests/playwright.config.ts $@",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component",
    "test:update-snapshots": "npx playwright test --update-snapshots -c tests/playwright.config.ts",
    "test:chrome": "npm test -- --project=chromium"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LicenseRef-Papit-1.0",
  "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/algorithms/moore-neighborhood",
  "bugs": {
    "url": "https://github.com/onkelhoy/papit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papit.git",
    "directory": "packages/algorithms/moore-neighborhood"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "playwright": "1.58.0",
    "typescript": "5.9.3",
    "@papit/theme": "*",
    "@papit/translator": "*",
    "@papit/codeblock": "*"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "browser",
    "main": "moore-neighborhood",
    "htmlprefix": "pap",
    "components": {
      "moore-neighborhood": {
        "className": "MooreNeighborhood",
        "htmlprefix": "pap"
      }
    }
  }
}