{
  "name": "@papit/corner-lookup",
  "description": "Generates marching squares and marching cubes case tables: every corner pattern mapped to a canonical case plus the rotation and mirror that restore it. Reach for it for dual-grid autotiling, modular building kits or marching cubes.",
  "keywords": [
    "papit",
    "node",
    "typescript",
    "corner-lookup",
    "marching-cubes",
    "marching-squares",
    "autotiling",
    "dual-grid",
    "procedural"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build --error",
    "watch": "tsc -w",
    "start": "npm run build -- --dev && node ./lib/bundle.js",
    "test": "node --test tests/**/*.test.js",
    "test:only": "node --test --test-only tests/**/*.test.js",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LicenseRef-Papit-1.0",
  "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/algorithms/corner-lookup",
  "bugs": {
    "url": "https://github.com/onkelhoy/papit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papit.git",
    "directory": "packages/algorithms/corner-lookup"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "node",
    "main": "corner-lookup",
    "components": {
      "corner-lookup": {
        "className": "CornerLookup",
        "htmlprefix": "pap"
      }
    }
  }
}