{
  "name": "@papit/sat",
  "description": "Separating Axis Theorem collision for polygons, returning the contact normal and overlap. Reach for it to detect and resolve collisions, concave polygons included when they are split into convex pieces.",
  "keywords": [
    "papit",
    "node",
    "typescript",
    "sat"
  ],
  "version": "0.0.2",
  "scripts": {
    "build": "npx @papit/build --error",
    "watch": "tsc -w",
    "start": "npm run build -- --dev && node ./lib/bundle.js",
    "view": "npx @papit/server --info --live",
    "test": "node --test tests/**/*.test.js",
    "test:only": "node --test --test-only tests/**/*.test.js",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LicenseRef-Papit-1.0",
  "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/algorithms/math/intersection/sat",
  "bugs": {
    "url": "https://github.com/onkelhoy/papit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papit.git",
    "directory": "packages/algorithms/math/intersection/sat"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/box-intersection": "0.0.2",
    "@papit/vector": "0.1.0"
  },
  "devDependencies": {
    "@papit/game-engine": "0.2.1",
    "@papit/game-shape": "0.0.5",
    "@papit/polygon": "0.0.2",
    "@papit/polygon-intersection": "0.0.2",
    "@papit/theme": "*",
    "@types/node": "22.10.2",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "node",
    "main": "sat",
    "components": {
      "sat": {
        "className": "SAT",
        "htmlprefix": "pap"
      }
    }
  },
  "remoteVersion": "0.0.1"
}