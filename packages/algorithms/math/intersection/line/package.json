{
  "name": "@papit/line-intersection",
  "description": "Line and segment intersection in 2D, closest points between segments and ray vs plane in 3D. Reach for it for line-of-sight, picking and capsule tests.",
  "keywords": [
    "papit",
    "node",
    "typescript",
    "line-intersection",
    "line",
    "segment",
    "closest-point",
    "ray",
    "plane",
    "3d",
    "collision"
  ],
  "version": "0.0.2",
  "scripts": {
    "build": "npx @papit/build --error",
    "watch": "tsc -w",
    "start": "npm run build -- --dev && node ./lib/bundle.js",
    "view": "npx @papit/server --info --live",
    "test": "node --test tests/**/*.test.js",
    "test:only": "node --test --test-only tests/**/*.test.js",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LicenseRef-Papit-1.0",
  "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/algorithms/math/intersection/line-intersection",
  "bugs": {
    "url": "https://github.com/onkelhoy/papit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papit.git",
    "directory": "packages/algorithms/math/intersection/line-intersection"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/vector": "0.0.2"
  },
  "devDependencies": {
    "@papit/circle-intersection": "0.0.2",
    "@papit/game-engine": "0.2.0",
    "@papit/game-shape": "0.0.5",
    "@papit/theme": "*",
    "@types/node": "22.10.2",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "node",
    "main": "line-intersection",
    "components": {
      "line-intersection": {
        "className": "LineIntersection",
        "htmlprefix": "pap"
      }
    }
  },
  "remoteVersion": "0.0.1"
}