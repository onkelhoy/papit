{
    "name": "@papit/analyse",
    "description": "Reads a web component package's source and writes analyse.json, describing each custom element's tag, properties, methods, events, states, slots, parts and CSS variables, along with its full extends chain. Use it to generate docs, editor data or framework wrappers from the code itself.",
    "keywords": [
        "papit",
        "cli",
        "node",
        "typescript",
        "analyse",
        "web-component",
        "custom-elements",
        "documentation",
        "manifest"
    ],
    "version": "0.0.3",
    "scripts": {
        "build": "npx @papit/build --error",
        "watch": "tsc -w",
        "start": "npm run build -- --dev && node ./lib/bin.js",
        "test": "node --test tests/**/*.test.js",
        "test:only": "node --test --test-only tests/**/*.test.js",
        "preversion": "papit-version",
        "postversion": "papit-version",
        "component": "npm create @papit -- --component"
    },
    "main": "./lib/bundle.js",
    "types": "./lib/bundle.d.ts",
    "type": "module",
    "files": [
        "asset/",
        "lib/"
    ],
    "exports": {
        ".": {
            "import": "./lib/bundle.js",
            "types": "./lib/bundle.d.ts"
        }
    },
    "bin": {
        "papit-analyse": "lib/bin.js"
    },
    "author": "henry",
    "private": false,
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "license": "LicenseRef-Papit-1.0",
    "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/runtime/cli/analyse",
    "bugs": {
        "url": "https://github.com/onkelhoy/papit/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/onkelhoy/papit.git",
        "directory": "packages/runtime/cli/analyse"
    },
    "sideEffects": true,
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@papit/arguments": "0.0.1",
        "@papit/information": "0.0.9",
        "@papit/lexer": "0.0.1",
        "@papit/terminal": "0.0.2",
        "typescript": "5.9.3"
    },
    "devDependencies": {
        "@types/node": "22.10.2"
    },
    "browserslist": [
        "defaults",
        "not IE 11",
        "not dead"
    ],
    "papit": {
        "publish": true,
        "type": "node",
        "main": "analyse",
        "components": {
            "analyse": {
                "className": "Analyse",
                "htmlprefix": "pap"
            }
        }
    },
    "remoteVersion": "0.0.3"
}