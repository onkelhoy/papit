{
  "name": "@papit/static",
  "description": "Command-line tool that turns a papit package folder into a self-contained static site for GitHub Pages, with its pages, assets, merged translations and dependency import map resolved the way @papit/server serves them.",
  "keywords": [
    "papit",
    "node",
    "typescript",
    "cli",
    "static-site",
    "github-pages",
    "import-map"
  ],
  "version": "0.0.2",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npm run build -- --dev && node ./lib/bin.js",
    "test": "node --test tests/**/*.test.js",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component"
  },
  "bin": {
    "papit-static": "lib/bin.js"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LicenseRef-Papit-1.0",
  "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/runtime/cli/static",
  "bugs": {
    "url": "https://github.com/onkelhoy/papit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papit.git",
    "directory": "packages/runtime/cli/static"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/arguments": "0.0.1",
    "@papit/bundle-js": "0.0.4",
    "@papit/html": "0.0.1",
    "@papit/information": "0.0.9",
    "@papit/server": "1.0.9",
    "@papit/terminal": "0.0.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.9.3"
  },
  "papit": {
    "publish": true,
    "type": "node",
    "main": "static",
    "components": {
      "static": {
        "className": "Static"
      }
    }
  },
  "remoteVersion": "0.0.1"
}