{
  "name": "@papit/signal-server",
  "description": "WebSocket signalling server for @papit/webrtc. Reach for it to register and list networks, admit peers and forward their handshake messages until they connect directly.",
  "keywords": [
    "papit",
    "signal-server",
    "signalling",
    "webrtc",
    "websocket",
    "p2p",
    "peer-message"
  ],
  "version": "0.0.4",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npm run build -- --dev && node ./lib/bundle.js",
    "test": "node --test tests/**/*.test.js",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component"
  },
  "bin": {
    "papit-signal-server": "lib/bin.js"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LicenseRef-Papit-1.0",
  "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/network/signal-server",
  "bugs": {
    "url": "https://github.com/onkelhoy/papit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papit.git",
    "directory": "packages/network/signal-server"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/arguments": "0.0.2",
    "@papit/peer-message": "0.0.3",
    "@papit/terminal": "0.0.3",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "node",
    "main": "signal-server",
    "components": {
      "signal-server": {
        "className": "Signal-server",
        "htmlprefix": "pap"
      }
    }
  },
  "remoteVersion": "0.0.3"
}