{
    "name": "@papit/webrtc",
    "description": "Peer-to-peer networking in the browser with a pluggable topology. Reach for it to route messages between peers over WebRTC or any transport, in a mesh, star, chord or your own topology, with plan-driven data channels and media streams.",
    "keywords": [
        "papit",
        "webrtc",
        "p2p",
        "peer-to-peer",
        "topology",
        "mesh",
        "chord",
        "router",
        "media"
    ],
    "version": "0.0.1",
    "scripts": {
        "build": "npx @papit/build -- --error --ancestors",
        "watch": "tsc -w",
        "start": "npx @papit/server --info --live",
        "test": "npx playwright test -c tests/playwright.config.ts $@",
        "preversion": "papit-version",
        "postversion": "papit-version",
        "component": "npm create @papit -- --component",
        "test:update-snapshots": "npx playwright test --update-snapshots -c tests/playwright.config.ts",
        "test:chrome": "npm test -- --project=chromium"
    },
    "main": "./lib/bundle.js",
    "types": "./lib/bundle.d.ts",
    "type": "module",
    "files": [
        "asset/",
        "lib/"
    ],
    "exports": {
        ".": {
            "import": "./lib/bundle.js",
            "types": "./lib/bundle.d.ts"
        }
    },
    "author": "henry",
    "private": false,
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "license": "LicenseRef-Papit-1.0",
    "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/network/webrtc",
    "bugs": {
        "url": "https://github.com/onkelhoy/papit/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/onkelhoy/papit.git",
        "directory": "packages/network/webrtc"
    },
    "sideEffects": true,
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@papit/peer-message": "0.0.1"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "playwright": "1.64.1",
        "typescript": "5.9.3"
    },
    "browserslist": [
        "defaults",
        "not IE 11",
        "not dead"
    ],
    "papit": {
        "publish": true,
        "type": "browser",
        "main": "webrtc",
        "htmlprefix": "",
        "components": {
            "link": {
                "className": "Link",
                "htmlprefix": "pap"
            },
            "topology": {
                "className": "Topology",
                "htmlprefix": "pap"
            },
            "network": {
                "className": "Network",
                "htmlprefix": "pap"
            },
            "socket": {
                "className": "Socket",
                "htmlprefix": "pap"
            },
            "peer": {
                "className": "Peer",
                "htmlprefix": "pap"
            },
            "handshake": {
                "className": "Handshake",
                "htmlprefix": "pap"
            }
        }
    },
    "remoteVersion": ""
}