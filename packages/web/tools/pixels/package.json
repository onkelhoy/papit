{
    "name": "@papit/pixels",
    "description": "Reads images and canvases pixel by pixel in the browser. Reach for it when game or algorithm code needs the color and position of each pixel.",
    "keywords": [
        "papit",
        "pixels",
        "image",
        "canvas",
        "imagedata"
    ],
    "version": "0.0.1",
    "scripts": {
        "build": "npx @papit/build -- --error --ancestors",
        "watch": "tsc -w",
        "start": "npx @papit/server --info --live",
        "test": "npx playwright test -c tests/playwright.config.ts",
        "preversion": "papit-version",
        "postversion": "papit-version",
        "component": "npm create @papit -- --component",
        "test:update-snapshots": "npx playwright test --update-snapshots -c tests/playwright.config.ts",
        "test:chrome": "npm test -- --project=chromium"
    },
    "main": "./lib/bundle.js",
    "types": "./lib/bundle.d.ts",
    "type": "module",
    "files": [
        "asset/",
        "lib/"
    ],
    "exports": {
        ".": {
            "import": "./lib/bundle.js",
            "types": "./lib/bundle.d.ts"
        }
    },
    "author": "henry",
    "private": false,
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "license": "LicenseRef-Papit-1.0",
    "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/web/tools/pixels",
    "bugs": {
        "url": "https://github.com/onkelhoy/papit/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/onkelhoy/papit.git",
        "directory": "packages/web/tools/pixels"
    },
    "sideEffects": true,
    "engines": {
        "node": ">=18"
    },
    "dependencies": {},
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "playwright": "1.64.1",
        "typescript": "5.9.3",
        "@papit/theme": "*"
    },
    "browserslist": [
        "defaults",
        "not IE 11",
        "not dead"
    ],
    "papit": {
        "publish": true,
        "type": "browser",
        "main": "pixels",
        "htmlprefix": "pap",
        "components": {
            "pixels": {
                "className": "Pixels",
                "htmlprefix": "pap"
            }
        }
    },
    "remoteVersion": "0.0.1"
}