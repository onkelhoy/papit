{
  "name": "@papit/drawer",
  "description": "A slide-in drawer panel that anchors to the left, right, top or bottom edge of the viewport. A static drawer is a modal overlay with backdrop, focus trap and Escape to close, and the default drawer is an in-flow, non-modal panel that pushes content.",
  "keywords": [
    "papit",
    "web-component",
    "typescript",
    "drawer",
    "dialog",
    "panel",
    "modal"
  ],
  "version": "0.0.8",
  "scripts": {
    "build": "npx @papit/build --error",
    "analyse": "npx @papit/analyse",
    "generate:react": "npx @papit/react",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "test": "npx playwright test -c tests/playwright.config.ts $@",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit --component",
    "test:update-snapshots": "npx playwright test --update-snapshots -c tests/playwright.config.ts",
    "test:chrome": "npm test -- --project=chromium"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    },
    "./react": {
      "import": "./lib/react-wrapper.js",
      "types": "./lib/react-wrapper.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LicenseRef-Papit-1.0",
  "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/web/design-system/atoms/drawer",
  "bugs": {
    "url": "https://github.com/onkelhoy/papit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papit.git",
    "directory": "packages/web/design-system/atoms/drawer"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/dialog": "0.0.15",
    "@papit/web-component": "0.0.12"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@papit/codeblock": "0.1.15",
    "@papit/router": "0.1.8",
    "@papit/tabs": "0.1.8",
    "@papit/theme": "0.0.3",
    "@papit/translator": "0.1.1",
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "web-component",
    "main": "drawer",
    "htmlprefix": "pap",
    "components": {
      "drawer": {
        "className": "Drawer",
        "htmlprefix": "pap"
      }
    }
  },
  "remoteVersion": "0.0.7"
}