{
  "name": "@papit/markdown",
  "description": "Markdown preview web component: renders markdown from a URL, a property or its own text content into safe, theme-styled HTML.",
  "keywords": [
    "papit",
    "web-component",
    "typescript",
    "markdown",
    "markdown-preview",
    "renderer",
    "commonmark",
    "gfm"
  ],
  "version": "0.0.9",
  "scripts": {
    "build": "npx @papit/build --error",
    "analyse": "npx @papit/analyse",
    "generate:react": "npx @papit/react",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "test": "npx playwright test -c tests/playwright.config.ts",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component",
    "test:update-snapshots": "npx playwright test --update-snapshots -c tests/playwright.config.ts",
    "test:chrome": "npm test -- --project=chromium"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "Henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LicenseRef-Papit-1.0",
  "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/web/design-system/molecules/markdown",
  "bugs": {
    "url": "https://github.com/onkelhoy/papit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papit.git",
    "directory": "packages/web/design-system/molecules/markdown"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/lexer": "0.0.2",
    "@papit/web-component": "0.0.14"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "@papit/theme": "0.0.3",
    "@papit/translator": "0.1.1",
    "@papit/codeblock": "0.1.18"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "web-component",
    "main": "markdown",
    "htmlprefix": "pap",
    "components": {
      "markdown": {
        "className": "Markdown",
        "htmlprefix": "pap"
      }
    }
  },
  "remoteVersion": "0.0.9"
}