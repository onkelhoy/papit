{
    "name": "@papit/placement",
    "description": "Positions its content on a chosen side of an anchor element with CSS anchor positioning, with an optional arrow marker. Use it as the floating layer of tooltips, menus and popovers.",
    "keywords": [
        "papit",
        "web-component",
        "typescript",
        "placement",
        "anchor-positioning",
        "popover",
        "tooltip"
    ],
    "version": "0.0.11",
    "scripts": {
        "build": "npx @papit/build --error",
        "analyse": "npx @papit/analyse",
        "generate:react": "npx @papit/react",
        "watch": "tsc -w",
        "start": "npx @papit/server --info --live",
        "test": "npx playwright test -c tests/playwright.config.ts $@",
        "preversion": "papit-version",
        "postversion": "papit-version",
        "component": "npm create @papit --component",
        "test:update-snapshots": "npx playwright test --update-snapshots -c tests/playwright.config.ts",
        "test:chrome": "npm test -- --project=chromium"
    },
    "main": "./lib/bundle.js",
    "types": "./lib/bundle.d.ts",
    "type": "module",
    "files": [
        "asset/",
        "lib/"
    ],
    "exports": {
        ".": {
            "import": "./lib/bundle.js",
            "types": "./lib/bundle.d.ts"
        },
        "./react": {
            "import": "./lib/react-wrapper.js",
            "types": "./lib/react-wrapper.d.ts"
        }
    },
    "author": "henry",
    "private": false,
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "license": "LicenseRef-Papit-1.0",
    "homepage": "https://github.com/onkelhoy/papit/tree/main/packages/web/design-system/foundations/placement",
    "bugs": {
        "url": "https://github.com/onkelhoy/papit/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/onkelhoy/papit.git",
        "directory": "packages/web/design-system/foundations/placement"
    },
    "sideEffects": true,
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@papit/web-component": "0.0.11"
    },
    "peerDependencies": {
        "react": "^19"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@papit/router": "0.1.7",
        "@papit/tabs": "0.1.7",
        "playwright": "1.64.1",
        "typescript": "5.9.3",
        "@papit/theme": "0.0.3",
        "@papit/translator": "0.1.1",
        "@papit/codeblock": "0.1.14"
    },
    "browserslist": [
        "defaults",
        "not IE 11",
        "not dead"
    ],
    "papit": {
        "publish": true,
        "skip": false,
        "type": "web-component",
        "main": "placement",
        "htmlprefix": "pap",
        "components": {
            "placement": {
                "className": "Placement",
                "htmlprefix": "pap"
            }
        }
    },
    "remoteVersion": "0.0.11"
}